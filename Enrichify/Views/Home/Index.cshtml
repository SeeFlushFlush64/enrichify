@{
    ViewData["Title"] = "Enrichify - Email Enrichment Made Simple";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- Hero Section -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <h1 class="display-2 fw-bold mb-4">Find Verified Emails Without Breaking the Bank</h1>
                <p class="lead fs-4 mb-4 text-muted">
                    Stop paying hundreds per month for Clay, Apollo, or ZoomInfo.
                    Get the same email enrichment power for a fraction of the cost.
                </p>
                <div class="d-flex gap-3 mb-4">
                    <a href="#upload" class="btn btn-primary btn-lg px-4 py-3">
                        Start Enriching <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a href="#how-it-works" class="btn btn-outline-secondary btn-lg px-4 py-3">
                        See How It Works
                    </a>
                </div>
                <div class="d-flex gap-4 text-muted">
                    <div>
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <small>No credit card required</small>
                    </div>
                    <div>
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <small>Verified emails only</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <partial name="_HeroImage" />
            </div>
        </div>
    </div>
</section>

<partial name="_ComparisonSection" />
<partial name="_HowItWorksSection" />
<partial name="_UploadSection" />
<partial name="_FeaturesSection" />
<partial name="_CTASection" />

@section Scripts {
    <script src="~/js/home.js"></script>
}